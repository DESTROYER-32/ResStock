# ==============================================================================
# ResStock Pro — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your custom settings:
#   cp .env.example .env
# ==============================================================================

# Application Environment Mode ('production' or 'development')
NODE_ENV=production

# Web Server Port (default: 5000)
PORT=5000

# JSON Web Token Secret Key
# IMPORTANT: Generate a long random secret key for production security
JWT_SECRET=super_secret_production_jwt_key_change_me_987654321

# ------------------------------------------------------------------------------
# Production Administrator Credentials
# ------------------------------------------------------------------------------
# Set your desired admin username and strong password for production deployment.
# The server will automatically initialize or synchronize the admin account with these credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetYourStrongAdminPasswordHere!
ADMIN_NAME=General Manager

# ------------------------------------------------------------------------------
# Demo Accounts & Sample Items Control
# ------------------------------------------------------------------------------
# Set to 'false' for a clean production installation without sample items.
SEED_DEMO_DATA=false

# Set to 'false' in production so 1-click demo login buttons are hidden from the login screen.
ENABLE_DEMO_LOGINS=false

# ------------------------------------------------------------------------------
# Store Display Currency
# ------------------------------------------------------------------------------
# Default currency symbol (₹, $, €, £, AED, ¥, etc.)
DEFAULT_CURRENCY=₹
